/*
 * Disease-regulatory flux map -- data-agnostic Nextflow pipeline.
 *
 * Pinned runtime: Nextflow 24.04.2 (run with `module load Nextflow/24.04.2`).
 * No cohort is hardcoded: every input path and file-format detail is a parameter,
 * so a new dataset is run by editing a params file, never by editing code.
 */

manifest {
    name            = 'disease-regulatory-flux'
    description     = 'Disease-regulatory flux map: cis/trans decomposition of TWAS associations'
    nextflowVersion = '>=24.04.2'
}

// Run every process with pipefail so a failure anywhere in a pipe fails the task
// (Nextflow's default `bash -ue` omits pipefail and can mask a mid-pipe error).
process.shell = ['/bin/bash', '-euo', 'pipefail']

params {
    outdir = 'results'

    // Input contract: a samplesheet CSV with a header and one row per tissue,
    //     tissue,expression,genotype,eqtl
    // where each path is that tissue's reference file (see README). All three
    // tables are tab-separated; the column names below are the shared contract.
    samplesheet     = null
    // Optional: a CSV with a header and one row per GWAS trait,
    //     trait,gwas
    // where `gwas` is the raw summary-statistics file. When set, the pipeline
    // harmonises each GWAS to the ALT allele (Step 8) and runs the TWAS
    // association per tissue and trait (Step 9). Leave null to stop after Step 7.
    gwas_samplesheet = null
    assoc_fdr        = 0.05         // p_adj threshold for a disease gene in the flux map (Step 10)
    input_delimiter = '\t'          // delimiter of all three input tables
    gene_col        = 'gene_id'     // shared gene-id column (expression + eQTL)
    rsid_col        = 'rsID'        // preferred variant key (genotype + eQTL)
    chrom_col       = 'chromosome'  // fallback chr:pos:ref:alt key
    pos_col         = 'position'
    ref_col         = 'ref'
    alt_col         = 'alt'
    eqtl_beta_col   = 'beta'        // eQTL effect-size column
    eqtl_se_col     = 'se'          // eQTL standard-error column
    eqtl_p_col      = 'pvalue'      // eQTL p-value column

    // cis-eQTL feature selection. The eQTL table is already cis; cis_max_pvalue optionally
    // keeps only pairs with p-value <= it (ignored when the table has no p-value column).
    cis_max_pvalue  = null          // e.g. 1e-3; null keeps every cis pair

    // LD filtering. Within each gene, a cis SNP is dropped when its r^2 with an
    // already-kept (more significant) SNP exceeds this threshold.
    ld_r2_threshold = 0.7

    // trans-feature construction. How many regulator hops to walk up the network when
    // collecting each gene's upstream cis SNPs (1 = direct regulators only).
    trans_max_hop   = 2

    // expression models. Each gene is fit by MCMC (NumPyro) under a channel-aware prior and
    // scored by PSIS leave-one-out (ArviZ); bayes_ridge is the default prior.
    expr_model        = 'bayes_ridge'  // bayes_ridge | horseshoe | bslmm
    expr_min_cis      = 1            // minimum cis SNPs for a gene to get a cis channel
    expr_max_trans    = 200          // cap on trans features per gene (kept by correlation)
    expr_mcmc_warmup  = 400          // MCMC warm-up iterations
    expr_mcmc_samples = 400          // MCMC sampling iterations
    expr_seed         = 1            // MCMC random seed

    // GRN reconstruction (BioFindr, Julia). BioFindr and its dependencies are pinned in
    // julia_project/ (Julia 1.11.3); julia_bin is the full path to the Julia executable
    // that runs it. Override julia_bin / julia_project_dir for a different install.
    julia_bin         = '/cluster/software/Julia/1.11.3-linux-x86_64/bin/julia.bin'
    julia_project_dir = "${projectDir}/julia_project"
    grn_cpus          = 8           // Julia threads for BioFindr's posterior loops
    grn_combination   = 'orig'      // BioFindr test combination: orig | IV | mediation
    grn_fdr           = 0.15        // false-discovery rate for kept edges
    grn_findr_method  = 'kde'       // LLR mixture fit: kde (robust) | moments (faster)
}

profiles {
    // Local execution (login/dev node): tasks run in the current shell. For smoke tests.
    standard {
        process.executor = 'local'
    }
    // HPC via SLURM: each process is its own job, so per-tissue tasks run in parallel.
    saga {
        process.executor       = 'slurm'
        process.clusterOptions = '--account=nn1015k'
        executor {
            name      = 'slurm'
            queueSize = 50
        }
    }
}

// Run report, timeline and trace for provenance.
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
